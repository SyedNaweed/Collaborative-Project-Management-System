<%- include('partials/header') %>

<div class="row justify-content-center my-5">
  <div class="col-md-6 text-center">
    <div class="card card-custom p-5">
      <div class="text-danger mb-3">
        <i class="bi bi-exclamation-octagon-fill" style="font-size: 3.5rem;"></i>
      </div>
      <h3 class="fw-bold mb-2"><%= typeof title !== 'undefined' ? title : 'Error' %></h3>
      <p class="text-muted mb-4"><%= typeof message !== 'undefined' ? message : 'An unexpected error occurred.' %></p>
      <div>
        <a href="javascript:history.back()" class="btn btn-outline-secondary me-2">
          <i class="bi bi-arrow-left"></i> Go Back
        </a>
        <a href="/" class="btn btn-primary-custom">
          <i class="bi bi-house-door"></i> Return Home
        </a>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
