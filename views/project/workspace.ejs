<%- include('../partials/header') %>

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
  <div>
    <div class="d-flex align-items-center gap-2">
      <h3 class="fw-bold text-dark mb-0"><%= project.title %></h3>
      <span class="status-badge status-<%= project.status.toLowerCase().replace('_', '') %>">
        <%= project.status %>
      </span>
      <% if (project.isArchived) { %>
        <span class="badge bg-secondary">Archived</span>
      <% } %>
    </div>
    <p class="text-muted small mb-0 mt-1">
      Team: <strong><%= project.team ? project.team.name : 'Team' %></strong> &bull;
      Faculty Guide: <strong><%= project.faculty ? project.faculty.fullName : 'Guide' %></strong>
    </p>
  </div>

  <div class="d-flex gap-2">
    <% if (currentUser && currentUser.role === 'FACULTY' && project.status !== 'COMPLETED') { %>
      <button class="btn btn-success btn-sm" data-bs-toggle="modal" data-bs-target="#evaluateProjectModal">
        <i class="bi bi-award-fill me-1"></i> Final Evaluation & Complete Project
      </button>
    <% } %>
    <a href="<%= currentUser && currentUser.role === 'FACULTY' ? '/faculty/dashboard' : '/student/dashboard' %>" class="btn btn-outline-secondary btn-sm">
      <i class="bi bi-arrow-left"></i> Dashboard
    </a>
  </div>
</div>

<!-- Proposal Review & Decision Card (if not yet approved) -->
<% if (['PROPOSED', 'REVISION_REQUESTED', 'REJECTED'].includes(project.status)) { %>
  <div class="card card-custom p-4 mb-4 border-start border-4 <%= project.status === 'REVISION_REQUESTED' ? 'border-warning bg-warning-subtle bg-opacity-25' : project.status === 'REJECTED' ? 'border-danger bg-danger-subtle bg-opacity-25' : 'border-primary bg-primary-subtle bg-opacity-25' %>">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
      <div>
        <div class="d-flex align-items-center gap-2 mb-1">
          <h5 class="fw-bold text-dark mb-0">
            <i class="bi bi-file-earmark-text me-1 <%= project.status === 'REJECTED' ? 'text-danger' : project.status === 'REVISION_REQUESTED' ? 'text-warning-emphasis' : 'text-primary' %>"></i>
            Project Proposal Status: <%= project.status.replace('_', ' ') %>
          </h5>
          <span class="badge <%= project.status === 'REVISION_REQUESTED' ? 'bg-warning text-dark' : project.status === 'REJECTED' ? 'bg-danger' : 'bg-primary' %>">
            <%= project.status === 'REJECTED' ? 'Rejected' : 'Awaiting Authorization' %>
          </span>
        </div>
        <% if (project.status === 'REVISION_REQUESTED' && project.revisionNotes) { %>
          <div class="alert alert-warning py-2 px-3 small my-2">
            <strong>Faculty Revision Instructions:</strong> <%= project.revisionNotes %>
          </div>
        <% } else if (project.status === 'REJECTED' && project.rejectionReason) { %>
          <div class="alert alert-danger py-2 px-3 small my-2">
            <strong>Rejection Reason:</strong> <%= project.rejectionReason %>
          </div>
        <% } else { %>
          <p class="text-muted small mb-0 mt-1">
            This project proposal is currently awaiting faculty review and authorization before active sprint tasks can begin.
          </p>
        <% } %>
      </div>

      <div>
        <% if (currentUser && currentUser.role === 'FACULTY' && project.status !== 'REJECTED') { %>
          <div class="d-flex gap-2">
            <button class="btn btn-success btn-sm btn-workspace-approve-proposal" data-id="<%= project._id %>">
              <i class="bi bi-check-lg me-1"></i> Approve Proposal
            </button>
            <button class="btn btn-warning btn-sm text-dark" data-bs-toggle="modal" data-bs-target="#workspaceRevisionModal">
              <i class="bi bi-pencil-square me-1"></i> Request Revision
            </button>
            <button class="btn btn-outline-danger btn-sm" data-bs-toggle="modal" data-bs-target="#workspaceRejectModal">
              <i class="bi bi-x-circle me-1"></i> Reject
            </button>
          </div>
        <% } else if (currentUser && currentUser.role === 'STUDENT' && project.status === 'REVISION_REQUESTED') { %>
          <button class="btn btn-primary-custom btn-sm" data-bs-toggle="modal" data-bs-target="#editResubmitModal">
            <i class="bi bi-pencil-square me-1"></i> Edit & Resubmit Proposal
          </button>
        <% } %>
      </div>
    </div>
  </div>
<% } %>

<!-- Evaluation Banner if Completed -->
<% if (project.evaluation && project.evaluation.score !== null) { %>
  <div class="card card-custom p-4 mb-4 border-start border-4 border-success bg-success-subtle bg-opacity-25">
    <div class="d-flex justify-content-between align-items-center">
      <div>
        <h5 class="fw-bold text-success mb-1"><i class="bi bi-check-circle-fill me-2"></i> Project Completed & Evaluated</h5>
        <p class="mb-0 text-dark small"><strong>Faculty Remarks:</strong> <%= project.evaluation.remarks %></p>
      </div>
      <div class="text-end">
        <span class="fs-2 fw-bold text-success"><%= project.evaluation.score %></span><span class="fs-5 text-muted">/100</span>
      </div>
    </div>
  </div>
<% } %>

<!-- Workspace Navigation Tabs -->
<ul class="nav nav-pills mb-4 gap-2" id="workspaceTabs" role="tablist">
  <li class="nav-item">
    <button class="nav-link active rounded-pill px-3 py-2" id="overview-tab" data-bs-toggle="pill" data-bs-target="#tab-overview">
      <i class="bi bi-info-circle me-1"></i> Overview
    </button>
  </li>
  <li class="nav-item">
    <button class="nav-link rounded-pill px-3 py-2" id="members-tab" data-bs-toggle="pill" data-bs-target="#tab-members">
      <i class="bi bi-people me-1"></i> Members (<%= project.participatingMembers.length %>)
    </button>
  </li>
  <li class="nav-item">
    <button class="nav-link rounded-pill px-3 py-2" id="tasks-tab" data-bs-toggle="pill" data-bs-target="#tab-tasks">
      <i class="bi bi-list-task me-1"></i> Tasks (<%= tasks.length %>)
    </button>
  </li>
  <li class="nav-item">
    <button class="nav-link rounded-pill px-3 py-2" id="issues-tab" data-bs-toggle="pill" data-bs-target="#tab-issues">
      <i class="bi bi-question-circle me-1"></i> Issues & Doubts (<%= issues.length %>)
    </button>
  </li>
</ul>

<div class="tab-content" id="workspaceTabContent">
  <!-- TAB 1: Project Overview -->
  <div class="tab-pane fade show active" id="tab-overview">
    <div class="card card-custom p-4 mb-4">
      <h5 class="fw-bold text-dark mb-3">Project Description & Scope</h5>
      <p class="text-secondary mb-4" style="white-space: pre-line;"><%= project.description %></p>

      <div class="row g-3 border-top pt-3">
        <div class="col-md-4">
          <span class="text-muted small d-block">Submitted Proposal Date:</span>
          <span class="fw-semibold text-dark"><%= new Date(project.createdAt).toLocaleDateString() %></span>
        </div>
        <div class="col-md-4">
          <span class="text-muted small d-block">Supervising Faculty:</span>
          <span class="fw-semibold text-dark"><%= project.faculty ? project.faculty.fullName : 'Guide' %> (<%= project.faculty ? project.faculty.email : '' %>)</span>
        </div>
        <div class="col-md-4">
          <span class="text-muted small d-block">Team Status:</span>
          <span class="fw-semibold text-dark"><%= project.team && project.team.isMixedTeam ? 'Mixed Internal + External' : 'Standard Team' %></span>
        </div>
      </div>
    </div>
  </div>

  <!-- TAB 2: Participating Members (ACTIVE vs FROZEN) -->
  <div class="tab-pane fade" id="tab-members">
    <div class="card card-custom p-4">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
          <h5 class="fw-bold text-dark mb-0">Project Participation Roster</h5>
          <span class="text-muted small">Distinct participation status: ACTIVE or FROZEN for this specific project</span>
        </div>
      </div>

      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th>Student Name</th>
              <th>Username</th>
              <th>Student Type</th>
              <th>Register Number</th>
              <th>Participation Status</th>
              <th class="text-end">Toggle Status</th>
            </tr>
          </thead>
          <tbody>
            <% project.participatingMembers.forEach(function(m) { %>
              <tr>
                <td><strong><%= m.student ? m.student.fullName : 'Student' %></strong></td>
                <td><span class="text-muted">@<%= m.student ? m.student.username : '' %></span></td>
                <td>
                  <span class="badge <%= (m.student && m.student.studentType === 'INTERNAL') ? 'badge-internal' : 'badge-external' %>">
                    <%= m.student ? m.student.studentType : '-' %>
                  </span>
                </td>
                <td>
                  <% if (m.student && m.student.registerNumber) { %>
                    <code class="text-primary"><%= m.student.registerNumber %></code>
                  <% } else { %>
                    <span class="text-muted small">N/A</span>
                  <% } %>
                </td>
                <td>
                  <% if (m.participationStatus === 'ACTIVE') { %>
                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                      <i class="bi bi-activity"></i> ACTIVE
                    </span>
                  <% } else { %>
                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1">
                      <i class="bi bi-snow"></i> FROZEN
                    </span>
                  <% } %>
                </td>
                <td class="text-end">
                  <% if (m.participationStatus === 'ACTIVE') { %>
                    <button class="btn btn-outline-secondary btn-sm btn-toggle-part" data-id="<%= m.student._id %>" data-status="FROZEN">
                      <i class="bi bi-snow"></i> Set Frozen
                    </button>
                  <% } else { %>
                    <button class="btn btn-outline-success btn-sm btn-toggle-part" data-id="<%= m.student._id %>" data-status="ACTIVE">
                      <i class="bi bi-activity"></i> Set Active
                    </button>
                  <% } %>
                  <% if (project.team && project.team.creator && currentUser && project.team.creator.toString() === currentUser._id.toString() && m.student && m.student._id.toString() !== currentUser._id.toString()) { %>
                    <button class="btn btn-outline-danger btn-sm btn-ws-remove-member ms-1" data-teamid="<%= project.team._id %>" data-memberid="<%= m.student._id %>" data-membername="<%= m.student.fullName %>" title="Remove Teammate from Team">
                      <i class="bi bi-person-x-fill"></i>
                    </button>
                  <% } %>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- TAB 3: Tasks, Dependencies, and Submissions -->
  <div class="tab-pane fade" id="tab-tasks">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h5 class="fw-bold text-dark mb-0">Project Task Pipeline</h5>
      <button class="btn btn-primary-custom btn-sm" data-bs-toggle="modal" data-bs-target="#createTaskModal">
        <i class="bi bi-plus-circle me-1"></i> New Task
      </button>
    </div>

    <div class="row g-3">
      <% if (tasks && tasks.length > 0) { %>
        <% tasks.forEach(function(task) { %>
          <div class="col-md-6">
            <div class="card card-custom p-4 h-100 d-flex flex-column justify-content-between">
              <div>
                <div class="d-flex justify-content-between align-items-start mb-2">
                  <h6 class="fw-bold text-dark mb-0"><%= task.title %></h6>
                  <span class="status-badge status-<%= task.status.toLowerCase().replace('_', '') %> small">
                    <%= task.status %>
                  </span>
                </div>
                <p class="text-muted small mb-2"><%= task.description %></p>
                
                <div class="small text-secondary mb-2">
                  <i class="bi bi-person me-1"></i> Assigned To: <strong><%= task.assignedTo ? task.assignedTo.fullName : 'Unassigned' %></strong>
                </div>

                <% if (task.dependencies && task.dependencies.length > 0) { %>
                  <div class="small bg-light p-2 rounded mb-2">
                    <span class="text-muted d-block" style="font-size: 0.75rem;">Prerequisite Tasks:</span>
                    <% task.dependencies.forEach(function(dep) { %>
                      <span class="badge bg-white text-dark border me-1">
                        <%= dep.title %> (<%= dep.status %>)
                      </span>
                    <% }); %>
                  </div>
                <% } %>

                <!-- Submissions & Version History -->
                <% if (task.submissions && task.submissions.length > 0) { %>
                  <div class="border-top pt-2 mt-2">
                    <span class="text-muted small fw-semibold">Version Submissions (<%= task.submissions.length %>):</span>
                    <% task.submissions.forEach(function(sub) { %>
                      <div class="bg-light p-2 rounded mt-1 small">
                        <div class="d-flex justify-content-between">
                          <strong class="text-primary">Version <%= sub.version %></strong>
                          <span class="text-muted" style="font-size: 0.72rem;"><%= new Date(sub.submittedAt).toLocaleDateString() %></span>
                        </div>
                        <div class="text-truncate my-1 font-mono"><%= sub.content %></div>
                        <% if (sub.aiReport && sub.aiReport.feedback) { %>
                          <div class="bg-white p-1 rounded border text-muted" style="font-size: 0.72rem;">
                            <i class="bi bi-robot text-primary"></i> <%= sub.aiReport.feedback %>
                          </div>
                        <% } %>
                      </div>
                    <% }); %>
                  </div>
                <% } %>
              </div>

              <div class="mt-3 pt-3 border-top d-flex gap-2 justify-content-between align-items-center flex-wrap">
                <% if (currentUser && currentUser.role === 'STUDENT') { %>
                  <% if (task.status !== 'COMPLETED') { %>
                    <button class="btn btn-outline-primary btn-sm btn-submit-deliverable" data-taskid="<%= task._id %>">
                      <i class="bi bi-upload me-1"></i> Submit Version
                    </button>
                  <% } else { %>
                    <span class="badge bg-success-subtle text-success border border-success-subtle py-2 px-3 small">
                      <i class="bi bi-check-all me-1"></i> Verified & Completed
                    </span>
                  <% } %>
                <% } else if (currentUser && currentUser.role === 'FACULTY') { %>
                  <% if (task.submissions && task.submissions.length > 0) { %>
                    <button class="btn btn-primary-custom btn-sm btn-open-verify-modal"
                            data-taskid="<%= task._id %>"
                            data-tasktitle="<%= task.title %>"
                            data-student="<%= task.assignedTo ? task.assignedTo.fullName : 'Student' %>"
                            data-status="<%= task.status %>"
                            data-submissions='<%- JSON.stringify(task.submissions) %>'>
                      <i class="bi bi-shield-check me-1"></i> Check & Verify Deliverable
                    </button>
                  <% } else { %>
                    <span class="badge bg-light text-muted border py-2 px-3 small">
                      <i class="bi bi-clock me-1"></i> Awaiting Student Submission
                    </span>
                  <% } %>
                <% } %>

                <div class="dropdown">
                  <button class="btn btn-outline-secondary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown">
                    Status: <%= task.status %>
                  </button>
                  <ul class="dropdown-menu dropdown-menu-end shadow">
                    <li><a class="dropdown-item btn-change-task-status" href="#" data-id="<%= task._id %>" data-status="TODO">TODO</a></li>
                    <li><a class="dropdown-item btn-change-task-status" href="#" data-id="<%= task._id %>" data-status="IN_PROGRESS">IN_PROGRESS</a></li>
                    <li><a class="dropdown-item btn-change-task-status" href="#" data-id="<%= task._id %>" data-status="IN_REVIEW">IN_REVIEW</a></li>
                    <li><a class="dropdown-item btn-change-task-status" href="#" data-id="<%= task._id %>" data-status="COMPLETED">COMPLETED</a></li>
                  </ul>
                </div>
              </div>
            </div>
          </div>
        <% }); %>
      <% } else { %>
        <div class="col-12 text-center py-4 text-muted">
          No tasks defined yet. Add smaller tasks to progress work through TODO &rarr; IN_PROGRESS &rarr; IN_REVIEW &rarr; COMPLETED.
        </div>
      <% } %>
    </div>
  </div>

  <!-- TAB 4: Issues and Doubts -->
  <div class="tab-pane fade" id="tab-issues">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h5 class="fw-bold text-dark mb-0">Issues and Doubts</h5>
      <button class="btn btn-outline-danger btn-sm" data-bs-toggle="modal" data-bs-target="#createIssueModal">
        <i class="bi bi-exclamation-circle me-1"></i> Raise Issue
      </button>
    </div>

    <% if (issues && issues.length > 0) { %>
      <div class="list-group">
        <% issues.forEach(function(iss) { %>
          <div class="list-group-item card-custom mb-3 p-3">
            <div class="d-flex justify-content-between align-items-start">
              <div>
                <h6 class="fw-bold mb-1 text-dark"><%= iss.title %></h6>
                <p class="text-muted small mb-2"><%= iss.description %></p>
                <span class="text-muted small">Raised by: <strong><%= iss.raisedBy ? iss.raisedBy.fullName : 'Student' %></strong></span>
              </div>
              <span class="badge <%= iss.status === 'RESOLVED' ? 'bg-success' : 'bg-warning text-dark' %>">
                <%= iss.status %>
              </span>
            </div>

            <% if (iss.status === 'RESOLVED') { %>
              <div class="bg-success-subtle p-2 rounded mt-2 small text-success-emphasis">
                <strong>Resolution:</strong> <%= iss.resolution %>
              </div>
            <% } else { %>
              <div class="mt-2 text-end">
                <button class="btn btn-outline-success btn-sm btn-resolve-issue" data-id="<%= iss._id %>">
                  <i class="bi bi-check2"></i> Add Resolution
                </button>
              </div>
            <% } %>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <div class="text-center py-4 text-muted">
        No open issues or doubts logged in this project workspace.
      </div>
    <% } %>
  </div>
</div>

<!-- Modal: Create Task -->
<div class="modal fade" id="createTaskModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content card-custom">
      <div class="modal-header border-0">
        <h5 class="modal-title fw-bold">Create New Project Task</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form id="createTaskForm">
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label small">Task Title <span class="text-danger">*</span></label>
            <input type="text" class="form-control" name="title" id="taskTitle" required placeholder="e.g. Database Schema Implementation">
          </div>
          <div class="mb-3">
            <label class="form-label small">Description</label>
            <textarea class="form-control" name="description" id="taskDesc" rows="2" placeholder="Task requirements and scope..."></textarea>
          </div>
          <div class="mb-3">
            <label class="form-label small">Assign To <span class="text-danger">*</span></label>
            <select class="form-select" name="assignedTo" id="taskAssignee" required>
              <option value="">-- Choose Member --</option>
              <% project.participatingMembers.filter(m => m.participationStatus === 'ACTIVE').forEach(function(m) { %>
                <option value="<%= m.student._id %>"><%= m.student.fullName %> (@<%= m.student.username %>)</option>
              <% }); %>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label small">Prerequisite Dependency Task (Optional)</label>
            <select class="form-select" name="dependencies" id="taskDep">
              <option value="">-- None (No prerequisites) --</option>
              <% tasks.forEach(function(t) { %>
                <option value="<%= t._id %>"><%= t.title %> (<%= t.status %>)</option>
              <% }); %>
            </select>
          </div>
        </div>
        <div class="modal-footer border-0">
          <button type="button" class="btn btn-light btn-sm" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary-custom btn-sm">Create Task</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Modal: Submit Deliverable -->
<div class="modal fade" id="submitDeliverableModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content card-custom">
      <div class="modal-header border-0">
        <h5 class="modal-title fw-bold">Submit Task Deliverable</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form id="submitDeliverableForm">
        <input type="hidden" id="submitTaskId" name="taskId">
        <div class="modal-body">
          <label class="form-label small">Deliverable Content / Repository Link / Summary <span class="text-danger">*</span></label>
          <textarea class="form-control" id="deliverableContent" rows="4" required placeholder="Paste GitHub pull request link, documentation, or code summary..."></textarea>
          <div class="form-text small text-muted mt-2">
            <i class="bi bi-robot text-primary"></i> Submissions undergo AI-Assisted verification analysis and increment version history.
          </div>
        </div>
        <div class="modal-footer border-0">
          <button type="button" class="btn btn-light btn-sm" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary-custom btn-sm">Submit Deliverable</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Modal: Create Issue -->
<div class="modal fade" id="createIssueModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content card-custom">
      <div class="modal-header border-0">
        <h5 class="modal-title fw-bold">Raise Issue or Doubt</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form id="createIssueForm">
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label small">Title <span class="text-danger">*</span></label>
            <input type="text" class="form-control" id="issueTitle" required placeholder="e.g. MongoDB replica set connection issue">
          </div>
          <div class="mb-3">
            <label class="form-label small">Description & Questions <span class="text-danger">*</span></label>
            <textarea class="form-control" id="issueDesc" rows="3" required placeholder="Explain the problem..."></textarea>
          </div>
        </div>
        <div class="modal-footer border-0">
          <button type="button" class="btn btn-light btn-sm" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-danger btn-sm">Log Issue</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Modal: Faculty Evaluation -->
<div class="modal fade" id="evaluateProjectModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content card-custom">
      <div class="modal-header border-0">
        <h5 class="modal-title fw-bold">Faculty Final Project Evaluation</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form id="evaluateProjectForm">
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label small">Final Score (0 to 100) <span class="text-danger">*</span></label>
            <input type="number" class="form-control" id="evalScore" min="0" max="100" required placeholder="e.g. 92">
          </div>
          <div class="mb-3">
            <label class="form-label small">Evaluation Remarks & Feedback</label>
            <textarea class="form-control" id="evalRemarks" rows="3" placeholder="Assess team collaboration, quality of submissions, and completeness..."></textarea>
          </div>
        </div>
        <div class="modal-footer border-0">
          <button type="button" class="btn btn-light btn-sm" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-success btn-sm">Finalize & Mark Completed</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Modal: Faculty Deliverable Verification -->
<div class="modal fade" id="facultyVerifyModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content card-custom">
      <div class="modal-header border-0 bg-light">
        <div>
          <h5 class="modal-title fw-bold text-dark mb-0">
            <i class="bi bi-shield-check text-primary me-2"></i> Deliverable Verification & Evaluation
          </h5>
          <span class="text-muted small">Verify submitted deliverables and inspect AI verification analysis</span>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>

      <div class="modal-body p-4">
        <!-- Task Header Summary -->
        <div class="d-flex justify-content-between align-items-center bg-light p-3 rounded-3 mb-4">
          <div>
            <h6 class="fw-bold mb-1 text-dark" id="modalVerifyTaskTitle">Task Title</h6>
            <span class="small text-muted"><i class="bi bi-person me-1"></i> Submitted by: <strong id="modalVerifyStudentName">Student</strong></span>
          </div>
          <span class="badge bg-warning text-dark px-3 py-2" id="modalVerifyStatusBadge">IN_REVIEW</span>
        </div>

        <!-- Dynamic Submissions Container -->
        <div id="modalVerifySubmissionsList">
          <!-- Dynamically populated with submissions & AI report -->
        </div>

        <!-- Faculty Decision Box -->
        <div class="border-top pt-3 mt-4">
          <h6 class="fw-bold text-dark mb-2"><i class="bi bi-pencil-square text-primary me-1"></i> Faculty Review Decision</h6>
          <div class="mb-3">
            <label class="form-label small text-muted">Feedback / Remarks for Student:</label>
            <textarea class="form-control" id="facultyVerifyRemarks" rows="2" placeholder="e.g. Code structure verified. Proper schema indexing confirmed. Approved."></textarea>
          </div>
          <div class="d-flex gap-2 justify-content-end">
            <button type="button" class="btn btn-outline-warning text-dark btn-sm" id="btnRequestTaskChanges">
              <i class="bi bi-arrow-repeat me-1"></i> Request Changes / Rework
            </button>
            <button type="button" class="btn btn-success btn-sm px-3" id="btnApproveTaskDeliverable">
              <i class="bi bi-check-circle-fill me-1"></i> Approve Deliverable (Mark COMPLETED)
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Modal: Workspace Proposal Revision (Faculty) -->
<div class="modal fade" id="workspaceRevisionModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content card-custom">
      <div class="modal-header border-0">
        <h6 class="modal-title fw-bold text-dark"><i class="bi bi-pencil-square text-warning me-2"></i> Request Proposal Revisions</h6>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <label class="form-label small text-muted">Instructions & Adjustments Required from Student Team:</label>
        <textarea class="form-control" id="workspaceRevNotes" rows="4" placeholder="Detail the modifications required before this proposal can be approved..."></textarea>
      </div>
      <div class="modal-footer border-0">
        <button type="button" class="btn btn-light btn-sm" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-warning btn-sm" id="btnWorkspaceSubmitRevision">Submit Revision Request</button>
      </div>
    </div>
  </div>
</div>

<!-- Modal: Workspace Proposal Reject (Faculty) -->
<div class="modal fade" id="workspaceRejectModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content card-custom">
      <div class="modal-header border-0">
        <h6 class="modal-title fw-bold text-danger"><i class="bi bi-x-circle me-2"></i> Reject Project Proposal</h6>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <label class="form-label small text-muted">Official Rejection Reason:</label>
        <textarea class="form-control" id="workspaceRejectReason" rows="3" placeholder="Provide detailed justification for rejecting this proposal..."></textarea>
      </div>
      <div class="modal-footer border-0">
        <button type="button" class="btn btn-light btn-sm" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-danger btn-sm" id="btnWorkspaceSubmitReject">Confirm Rejection</button>
      </div>
    </div>
  </div>
</div>

<!-- Modal: Edit & Resubmit Proposal (Student) -->
<div class="modal fade" id="editResubmitModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content card-custom">
      <div class="modal-header border-0">
        <h5 class="modal-title fw-bold text-dark"><i class="bi bi-pencil-square text-primary me-2"></i> Edit & Resubmit Proposal</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form id="editResubmitForm">
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label small text-muted">Project Title <span class="text-danger">*</span></label>
            <input type="text" class="form-control" id="resubmitTitle" value="<%= project.title %>" required>
          </div>
          <div class="mb-3">
            <label class="form-label small text-muted">Project Description & Scope <span class="text-danger">*</span></label>
            <textarea class="form-control" id="resubmitDescription" rows="5" required><%= project.description %></textarea>
          </div>
        </div>
        <div class="modal-footer border-0">
          <button type="button" class="btn btn-light btn-sm" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary-custom btn-sm">Resubmit for Faculty Review</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
$(document).ready(function() {
  const projectId = '<%= project._id %>';

  // Toggle Participation (ACTIVE vs FROZEN)
  $('.btn-toggle-part').on('click', function() {
    const studentId = $(this).data('id');
    const status = $(this).data('status');

    $.ajax({
      url: `/project/${projectId}/toggle-participation`,
      type: 'POST',
      contentType: 'application/json',
      data: JSON.stringify({ studentId, status }),
      success: function(res) {
        window.location.reload();
      },
      error: function(xhr) {
        alert(xhr.responseJSON ? xhr.responseJSON.message : 'Error updating participation.');
      }
    });
  });

  // Create Task
  $('#createTaskForm').on('submit', function(e) {
    e.preventDefault();
    const payload = {
      title: $('#taskTitle').val(),
      description: $('#taskDesc').val(),
      assignedTo: $('#taskAssignee').val(),
      dependencies: $('#taskDep').val() ? [$('#taskDep').val()] : []
    };

    $.ajax({
      url: `/project/${projectId}/create-task`,
      type: 'POST',
      contentType: 'application/json',
      data: JSON.stringify(payload),
      success: function(res) {
        window.location.reload();
      },
      error: function(xhr) {
        alert(xhr.responseJSON ? xhr.responseJSON.message : 'Error creating task.');
      }
    });
  });

  // Change Task Status (with Dependency Verification)
  $('.btn-change-task-status').on('click', function(e) {
    e.preventDefault();
    const taskId = $(this).data('id');
    const status = $(this).data('status');

    $.ajax({
      url: `/project/task/${taskId}/status`,
      type: 'POST',
      contentType: 'application/json',
      data: JSON.stringify({ status }),
      success: function(res) {
        window.location.reload();
      },
      error: function(xhr) {
        alert(xhr.responseJSON ? xhr.responseJSON.message : 'Prerequisite tasks must be COMPLETED first.');
      }
    });
  });

  // Open Deliverable Modal
  $('.btn-submit-deliverable').on('click', function() {
    const taskId = $(this).data('taskid');
    $('#submitTaskId').val(taskId);
    $('#deliverableContent').val('');
    new bootstrap.Modal('#submitDeliverableModal').show();
  });

  // Submit Deliverable
  $('#submitDeliverableForm').on('submit', function(e) {
    e.preventDefault();
    const taskId = $('#submitTaskId').val();
    const content = $('#deliverableContent').val();

    $.ajax({
      url: `/project/task/${taskId}/submit`,
      type: 'POST',
      contentType: 'application/json',
      data: JSON.stringify({ content }),
      success: function(res) {
        alert(res.message);
        window.location.reload();
      },
      error: function(xhr) {
        alert(xhr.responseJSON ? xhr.responseJSON.message : 'Error submitting deliverable.');
      }
    });
  });

  // Create Issue
  $('#createIssueForm').on('submit', function(e) {
    e.preventDefault();
    const payload = {
      title: $('#issueTitle').val(),
      description: $('#issueDesc').val()
    };

    $.ajax({
      url: `/project/${projectId}/create-issue`,
      type: 'POST',
      contentType: 'application/json',
      data: JSON.stringify(payload),
      success: function(res) {
        window.location.reload();
      },
      error: function(xhr) {
        alert(xhr.responseJSON ? xhr.responseJSON.message : 'Error creating issue.');
      }
    });
  });

  // Resolve Issue
  $('.btn-resolve-issue').on('click', function() {
    const issueId = $(this).data('id');
    const resolution = prompt('Enter resolution for this issue:');
    if (!resolution || !resolution.trim()) return;

    $.ajax({
      url: `/project/issue/${issueId}/resolve`,
      type: 'POST',
      contentType: 'application/json',
      data: JSON.stringify({ resolution }),
      success: function(res) {
        window.location.reload();
      },
      error: function(xhr) {
        alert('Error resolving issue.');
      }
    });
  });

  // Faculty Evaluation Submit
  $('#evaluateProjectForm').on('submit', function(e) {
    e.preventDefault();
    const payload = {
      projectId: projectId,
      score: $('#evalScore').val(),
      remarks: $('#evalRemarks').val()
    };

    $.ajax({
      url: '/faculty/evaluate-project',
      type: 'POST',
      contentType: 'application/json',
      data: JSON.stringify(payload),
      success: function(res) {
        alert(res.message);
        window.location.reload();
      },
      error: function(xhr) {
        alert(xhr.responseJSON ? xhr.responseJSON.message : 'Error evaluating project.');
      }
    });
  });

  // Faculty Deliverable Verification Modal
  let currentVerifyTaskId = null;
  $('.btn-open-verify-modal').on('click', function() {
    currentVerifyTaskId = $(this).data('taskid');
    const taskTitle = $(this).data('tasktitle');
    const studentName = $(this).data('student');
    const status = $(this).data('status');
    const rawSubs = $(this).attr('data-submissions');
    let submissions = [];
    try {
      submissions = JSON.parse(rawSubs);
    } catch (e) {
      submissions = [];
    }

    $('#modalVerifyTaskTitle').text(taskTitle);
    $('#modalVerifyStudentName').text(studentName);
    $('#modalVerifyStatusBadge').text(status);
    $('#facultyVerifyRemarks').val('');

    let html = '';
    if (!submissions || submissions.length === 0) {
      html = '<div class="text-muted text-center py-4"><i class="bi bi-clock fs-3 d-block mb-2"></i>No deliverables submitted for this task yet.</div>';
    } else {
      submissions.slice().reverse().forEach(function(sub, idx) {
        const isLatest = idx === 0;
        const ai = sub.aiReport || {};
        const fr = sub.facultyReview || {};
        html += `
          <div class="card border mb-3 ${isLatest ? 'border-primary shadow-sm' : ''}">
            <div class="card-header bg-light d-flex justify-content-between align-items-center py-2">
              <span class="fw-bold text-dark">
                Version ${sub.version} ${isLatest ? '<span class="badge bg-primary ms-1">Latest Version</span>' : ''}
              </span>
              <span class="text-muted small" style="font-size: 0.75rem;">${new Date(sub.submittedAt).toLocaleString()}</span>
            </div>
            <div class="card-body p-3">
              <label class="form-label small text-muted mb-1 fw-semibold">Student Deliverable Link / Submission Summary:</label>
              <div class="p-2 bg-light rounded font-mono text-dark small mb-3 text-break" style="max-height: 120px; overflow-y: auto;">
                ${sub.content}
              </div>

              <!-- AI Verification Insights Card -->
              <div class="p-3 bg-white border rounded-3 mb-2">
                <div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
                  <i class="bi bi-robot text-primary fs-5"></i>
                  <strong class="text-dark small">AI-Assisted Verification Analysis:</strong>
                  <span class="badge bg-success-subtle text-success border border-success-subtle">
                    Similarity: ${ai.similarityScore !== undefined ? ai.similarityScore : 4}% (Low Risk)
                  </span>
                  <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                    Scope: Task Aligned
                  </span>
                  <span class="badge bg-info-subtle text-dark border border-info-subtle">
                    Deliverable Format: Valid
                  </span>
                </div>
                <div class="small text-secondary">
                  <i class="bi bi-info-circle me-1 text-primary"></i> ${ai.feedback || 'AI Verification: Deliverables match task scope and criteria. Ready for faculty review.'}
                </div>
              </div>

              ${fr.status ? `
                <div class="alert ${fr.status === 'APPROVED' ? 'alert-success' : 'alert-warning'} py-2 px-3 small mt-2 mb-0">
                  <strong>Faculty Status:</strong> ${fr.status} &bull; <em>"${fr.remarks || 'No remarks recorded.'}"</em>
                </div>
              ` : ''}
            </div>
          </div>
        `;
      });
    }

    $('#modalVerifySubmissionsList').html(html);
    new bootstrap.Modal('#facultyVerifyModal').show();
  });

  // Approve Deliverable (Faculty)
  $('#btnApproveTaskDeliverable').on('click', function() {
    if (!currentVerifyTaskId) return;
    const remarks = $('#facultyVerifyRemarks').val();
    const $btn = $(this);
    $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm"></span> Approving...');

    $.ajax({
      url: `/project/task/${currentVerifyTaskId}/verify`,
      type: 'POST',
      contentType: 'application/json',
      data: JSON.stringify({ action: 'APPROVE', remarks }),
      success: function(res) {
        alert(res.message);
        window.location.reload();
      },
      error: function(xhr) {
        $btn.prop('disabled', false).html('<i class="bi bi-check-circle-fill me-1"></i> Approve Deliverable (Mark COMPLETED)');
        alert(xhr.responseJSON ? xhr.responseJSON.message : 'Error approving deliverable.');
      }
    });
  });

  // Request Rework / Changes (Faculty)
  $('#btnRequestTaskChanges').on('click', function() {
    if (!currentVerifyTaskId) return;
    const remarks = $('#facultyVerifyRemarks').val();
    if (!remarks || !remarks.trim()) {
      alert('Please provide instructions/remarks for the student explaining what needs to be revised.');
      $('#facultyVerifyRemarks').focus();
      return;
    }
    const $btn = $(this);
    $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm"></span> Requesting Changes...');

    $.ajax({
      url: `/project/task/${currentVerifyTaskId}/verify`,
      type: 'POST',
      contentType: 'application/json',
      data: JSON.stringify({ action: 'REQUEST_CHANGES', remarks }),
      success: function(res) {
        alert(res.message);
        window.location.reload();
      },
      error: function(xhr) {
        $btn.prop('disabled', false).html('<i class="bi bi-arrow-repeat me-1"></i> Request Changes / Rework');
        alert(xhr.responseJSON ? xhr.responseJSON.message : 'Error requesting changes.');
      }
    });
  });

  // Workspace Approve Proposal (Faculty)
  $('.btn-workspace-approve-proposal').on('click', function() {
    if (!confirm('Approve this project proposal? This authorizes the team to start project tasks.')) return;
    $.ajax({
      url: '/faculty/proposal-decision',
      type: 'POST',
      contentType: 'application/json',
      data: JSON.stringify({ projectId, action: 'APPROVE' }),
      success: function(res) {
        alert(res.message);
        window.location.reload();
      },
      error: function(xhr) {
        alert(xhr.responseJSON ? xhr.responseJSON.message : 'Error approving proposal.');
      }
    });
  });

  // Workspace Request Revision (Faculty)
  $('#btnWorkspaceSubmitRevision').on('click', function() {
    const revisionNotes = $('#workspaceRevNotes').val();
    if (!revisionNotes || !revisionNotes.trim()) {
      alert('Please enter revision instructions.');
      return;
    }
    $.ajax({
      url: '/faculty/proposal-decision',
      type: 'POST',
      contentType: 'application/json',
      data: JSON.stringify({ projectId, action: 'REVISION', revisionNotes }),
      success: function(res) {
        alert(res.message);
        window.location.reload();
      },
      error: function(xhr) {
        alert(xhr.responseJSON ? xhr.responseJSON.message : 'Error requesting revisions.');
      }
    });
  });

  // Workspace Reject Proposal (Faculty)
  $('#btnWorkspaceSubmitReject').on('click', function() {
    const reason = $('#workspaceRejectReason').val();
    if (!reason || !reason.trim()) {
      alert('Please specify rejection reason.');
      return;
    }
    $.ajax({
      url: '/faculty/proposal-decision',
      type: 'POST',
      contentType: 'application/json',
      data: JSON.stringify({ projectId, action: 'REJECT', reason }),
      success: function(res) {
        alert(res.message);
        window.location.reload();
      },
      error: function(xhr) {
        alert(xhr.responseJSON ? xhr.responseJSON.message : 'Error rejecting proposal.');
      }
    });
  });

  // Edit & Resubmit Proposal (Student)
  $('#editResubmitForm').on('submit', function(e) {
    e.preventDefault();
    const payload = {
      title: $('#resubmitTitle').val(),
      description: $('#resubmitDescription').val()
    };
    $.ajax({
      url: `/project/${projectId}/resubmit-proposal`,
      type: 'POST',
      contentType: 'application/json',
      data: JSON.stringify(payload),
      success: function(res) {
        alert(res.message);
        window.location.reload();
      },
      error: function(xhr) {
        alert(xhr.responseJSON ? xhr.responseJSON.message : 'Error resubmitting proposal.');
      }
    });
  });

  // Workspace Remove Member by Creator
  $('.btn-ws-remove-member').on('click', function() {
    const teamId = $(this).data('teamid');
    const memberId = $(this).data('memberid');
    const memberName = $(this).data('membername');

    if (!confirm(`Are you sure you want to remove ${memberName} from this team? Any active incomplete tasks will be returned to the unassigned project pool.`)) {
      return;
    }

    $.ajax({
      url: `/student/team/${teamId}/remove-member`,
      type: 'POST',
      contentType: 'application/json',
      data: JSON.stringify({ memberId }),
      success: function(res) {
        alert(res.message);
        window.location.reload();
      },
      error: function(xhr) {
        alert(xhr.responseJSON ? xhr.responseJSON.message : 'Error removing teammate.');
      }
    });
  });
});
</script>

<%- include('../partials/footer') %>
