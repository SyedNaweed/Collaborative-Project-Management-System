<%- include('../partials/header') %>

<div class="row g-4">
  <!-- Left Column: Student Profile & Guide -->
  <div class="col-lg-4">
    <!-- Profile Card -->
    <div class="card card-custom p-4 mb-4">
      <div class="d-flex align-items-center gap-3 mb-3">
        <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center" style="width: 55px; height: 55px;">
          <i class="bi bi-person-fill fs-2"></i>
        </div>
        <div>
          <h5 class="fw-bold mb-0 text-dark"><%= student.fullName %></h5>
          <span class="text-muted small">@<%= student.username %></span>
        </div>
      </div>

      <div class="border-top pt-3">
        <div class="d-flex justify-content-between align-items-center mb-2">
          <span class="text-muted small">Student Type:</span>
          <span class="badge <%= student.studentType === 'INTERNAL' ? 'badge-internal' : 'badge-external' %>">
            <%= student.studentType %>
          </span>
        </div>
        <% if (student.studentType === 'INTERNAL') { %>
          <div class="d-flex justify-content-between align-items-center mb-2">
            <span class="text-muted small">Register Number:</span>
            <code class="fw-bold text-primary"><%= student.registerNumber %></code>
          </div>
        <% } %>
        <div class="d-flex justify-content-between align-items-center mb-2">
          <span class="text-muted small">College Email:</span>
          <span class="small font-mono text-dark"><%= student.email %></span>
        </div>
        <div class="d-flex justify-content-between align-items-center">
          <span class="text-muted small">Assigned Guide:</span>
          <span class="small fw-semibold text-dark">
            <%= student.assignedFaculty ? student.assignedFaculty.fullName : 'None (Select Below)' %>
          </span>
        </div>
      </div>

      <% if (!student.assignedFaculty) { %>
        <div class="mt-3">
          <a href="/student/select-faculty" class="btn btn-outline-primary btn-sm w-100">
            <i class="bi bi-person-lines-fill me-1"></i> Choose Faculty Guide
          </a>
        </div>
      <% } %>
    </div>

    <!-- Quick Actions Card -->
    <div class="card card-custom p-4">
      <h6 class="fw-bold text-dark mb-3"><i class="bi bi-lightning-charge me-1 text-primary"></i> Quick Actions</h6>
      <div class="d-grid gap-2">
        <a href="/student/select-faculty" class="btn btn-light text-start btn-sm py-2">
          <i class="bi bi-search me-2 text-primary"></i> Browse Faculty Directory
        </a>
        <a href="/student/create-team" class="btn btn-light text-start btn-sm py-2">
          <i class="bi bi-people me-2 text-primary"></i> Create / Manage Team
        </a>
      </div>
    </div>
  </div>

  <!-- Right Column: Active Team & Project Workspace -->
  <div class="col-lg-8">
    <% if (activeTeam) { %>
      <!-- Active Team Card -->
      <div class="card card-custom p-4 mb-4">
        <div class="d-flex justify-content-between align-items-start mb-3">
          <div>
            <div class="d-flex align-items-center gap-2 mb-1">
              <h4 class="fw-bold text-dark mb-0"><%= activeTeam.name %></h4>
              <% if (activeTeam.isMixedTeam) { %>
                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle small">
                  <i class="bi bi-shuffle me-1"></i> Mixed Collaboration
                </span>
              <% } %>
            </div>
            <p class="text-muted small mb-0">
              Faculty Guide: <strong><%= activeTeam.faculty ? activeTeam.faculty.fullName : 'Unassigned' %></strong>
            </p>
          </div>
          <div class="d-flex gap-2">
            <% if (activeTeam.creator.toString() === student._id.toString()) { %>
              <button class="btn btn-outline-danger btn-sm rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#deleteTeamModal">
                <i class="bi bi-trash3-fill me-1"></i> Delete Team
              </button>
            <% } else { %>
              <button class="btn btn-outline-danger btn-sm rounded-pill px-3" id="btnLeaveTeam" data-teamid="<%= activeTeam._id %>">
                <i class="bi bi-box-arrow-left me-1"></i> Leave Team
              </button>
            <% } %>
          </div>
        </div>

        <!-- Teammates -->
        <div class="bg-light p-3 rounded-3 mb-4">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <h6 class="fw-semibold text-secondary small text-uppercase mb-0">Team Members (<%= activeTeam.members.filter(m => m.status === 'ACTIVE').length %>)</h6>
            <% if (activeTeam.creator.toString() === student._id.toString()) { %>
              <span class="text-muted small" style="font-size: 0.72rem;"><i class="bi bi-shield-check text-primary"></i> Team Creator Controls Enabled</span>
            <% } %>
          </div>
          <div class="row g-2">
            <% activeTeam.members.filter(m => m.status === 'ACTIVE').forEach(function(m) { %>
              <div class="col-md-6">
                <div class="bg-white p-2 rounded-3 border d-flex justify-content-between align-items-center small">
                  <div>
                    <span class="fw-semibold text-dark"><%= m.student ? m.student.fullName : 'Member' %></span>
                    <span class="text-muted">(@<%= m.student ? m.student.username : '' %>)</span>
                    <% if (m.student && activeTeam.creator.toString() === m.student._id.toString()) { %>
                      <span class="badge bg-primary bg-opacity-10 text-primary ms-1" style="font-size: 0.65rem;">Creator</span>
                    <% } %>
                  </div>
                  <div class="d-flex align-items-center gap-2">
                    <span class="badge <%= m.studentType === 'INTERNAL' ? 'badge-internal' : 'badge-external' %>">
                      <%= m.studentType %>
                    </span>
                    <% if (activeTeam.creator.toString() === student._id.toString() && m.student && m.student._id.toString() !== student._id.toString()) { %>
                      <button type="button" class="btn btn-outline-danger btn-sm py-0 px-2 btn-remove-teammate" 
                              data-teamid="<%= activeTeam._id %>" 
                              data-memberid="<%= m.student._id %>" 
                              data-membername="<%= m.student.fullName %>"
                              title="Delete teammate from team">
                        <i class="bi bi-person-x-fill me-1"></i> Remove
                      </button>
                    <% } %>
                  </div>
                </div>
              </div>
            <% }); %>
          </div>
        </div>

        <!-- Current Project Status -->
        <div class="border-top pt-3">
          <% if (activeTeam.currentProject) { %>
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
              <div>
                <span class="text-muted small d-block">Current Project</span>
                <h5 class="fw-bold text-dark mb-1"><%= activeTeam.currentProject.title %></h5>
                <div class="d-flex align-items-center gap-2">
                  <span class="status-badge status-<%= activeTeam.currentProject.status.toLowerCase().replace('_', '') %>">
                    <i class="bi bi-circle-fill" style="font-size: 0.5rem;"></i> <%= activeTeam.currentProject.status %>
                  </span>
                  <span class="text-muted small">
                    Assigned by: <strong><%= activeTeam.faculty ? activeTeam.faculty.fullName : 'Guide' %></strong>
                  </span>
                </div>
              </div>
              <a href="/project/<%= activeTeam.currentProject._id %>/workspace" class="btn btn-primary-custom">
                <i class="bi bi-layout-text-window-reverse me-1"></i> Open Project Workspace
              </a>
            </div>
          <% } else { %>
            <div class="text-center py-4 bg-light rounded-3">
              <i class="bi bi-hourglass-split text-warning-emphasis fs-2 mb-2 d-block"></i>
              <h6 class="fw-bold text-dark mb-1">Awaiting Project Assignment</h6>
              <p class="text-muted small mb-2">
                Your supervising faculty guide (<strong><%= activeTeam.faculty ? activeTeam.faculty.fullName : 'Faculty Guide' %></strong>) will assign an academic project topic and scope directly to your team.
              </p>
              <span class="badge bg-primary bg-opacity-10 text-primary small px-3 py-2">
                <i class="bi bi-info-circle me-1"></i> Your project workspace and task board will activate automatically once assigned
              </span>
            </div>
          <% } %>
        </div>
      </div>
    <% } else { %>
      <!-- No Team Notice -->
      <div class="card card-custom p-5 text-center mb-4">
        <i class="bi bi-people-fill text-muted fs-1 mb-3"></i>
        <h4 class="fw-bold text-dark">You are not in an active team</h4>
        <p class="text-muted small mb-4">Select a faculty guide and create a team of 1 to 9 students to start your project.</p>
        <div>
          <a href="/student/create-team" class="btn btn-primary-custom px-4">
            <i class="bi bi-plus-circle me-1"></i> Create a Team Now
          </a>
        </div>
      </div>
    <% } %>

    <!-- Student Tasks Section -->
    <div class="card card-custom p-4">
      <h5 class="fw-bold text-dark mb-3"><i class="bi bi-check2-square text-primary me-2"></i> My Assigned Tasks</h5>
      <% if (tasks && tasks.length > 0) { %>
        <div class="list-group list-group-flush">
          <% tasks.forEach(function(task) { %>
            <div class="list-group-item px-0 py-3 d-flex justify-content-between align-items-center">
              <div>
                <h6 class="fw-bold mb-1 text-dark"><%= task.title %></h6>
                <p class="text-muted small mb-0"><%= task.description %></p>
              </div>
              <span class="status-badge status-<%= task.status.toLowerCase().replace('_', '') %>">
                <%= task.status %>
              </span>
            </div>
          <% }); %>
        </div>
      <% } else { %>
        <p class="text-muted small mb-0">No assigned tasks currently pending for your account.</p>
      <% } %>
    </div>
  </div>
</div>

<script>
$(document).ready(function() {

  // Leave team AJAX
  $('#btnLeaveTeam').on('click', function() {
    if (!confirm('Are you sure you want to leave this team? Remember: institutional policy prevents leaving while an active project is ongoing.')) {
      return;
    }
    const teamId = $(this).data('teamid');

    $.ajax({
      url: '/student/leave-team',
      type: 'POST',
      contentType: 'application/json',
      data: JSON.stringify({ teamId }),
      success: function(res) {
        alert(res.message);
        window.location.reload();
      },
      error: function(xhr) {
        const msg = xhr.responseJSON && xhr.responseJSON.message ? xhr.responseJSON.message : 'Cannot leave team.';
        alert(msg);
      }
    });
  });

  // Delete Team Handler
  $('#btnConfirmDeleteTeam').on('click', function() {
    const $btn = $(this);
    const teamId = $btn.data('teamid');
    $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span> Deleting...');

    $.ajax({
      url: `/student/team/${teamId}/delete`,
      type: 'POST',
      contentType: 'application/json',
      data: JSON.stringify({}),
      success: function(res) {
        $('#deleteTeamModal').modal('hide');
        alert(res.message);
        window.location.href = res.redirectUrl || '/student/dashboard';
      },
      error: function(xhr) {
        $btn.prop('disabled', false).html('<i class="bi bi-trash3-fill me-1"></i> Yes, Delete Team');
        const msg = xhr.responseJSON && xhr.responseJSON.message ? xhr.responseJSON.message : 'Error deleting team.';
        alert(msg);
      }
    });
  });

  // Delete Teammate Open Modal
  let activeRemoveTeamId = null;
  let activeRemoveMemberId = null;

  $('.btn-remove-teammate').on('click', function() {
    activeRemoveTeamId = $(this).data('teamid');
    activeRemoveMemberId = $(this).data('memberid');
    const memberName = $(this).data('membername');

    $('#deleteTeammateName').text(memberName);
    $('#deleteTeammateModal').modal('show');
  });

  // Delete Teammate Confirm Handler
  $('#btnConfirmDeleteTeammate').on('click', function() {
    if (!activeRemoveTeamId || !activeRemoveMemberId) return;

    const $btn = $(this);
    $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span> Removing...');

    $.ajax({
      url: `/student/team/${activeRemoveTeamId}/remove-member`,
      type: 'POST',
      contentType: 'application/json',
      data: JSON.stringify({ memberId: activeRemoveMemberId }),
      success: function(res) {
        $('#deleteTeammateModal').modal('hide');
        alert(res.message);
        window.location.reload();
      },
      error: function(xhr) {
        $btn.prop('disabled', false).html('<i class="bi bi-person-x-fill me-1"></i> Yes, Remove Teammate');
        const msg = xhr.responseJSON && xhr.responseJSON.message ? xhr.responseJSON.message : 'Error removing teammate.';
        alert(msg);
      }
    });
  });
});
</script>

<!-- Modal: Delete Team Confirmation -->
<% if (activeTeam) { %>
<div class="modal fade" id="deleteTeamModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content card-custom">
      <div class="modal-header border-0 pb-0">
        <h5 class="modal-title fw-bold text-danger"><i class="bi bi-exclamation-triangle-fill me-2"></i> Delete Team</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body py-3">
        <p class="mb-2 text-dark">Are you sure you want to permanently delete team <strong><%= activeTeam.name %></strong>?</p>
        <div class="alert alert-warning small mb-0">
          <i class="bi bi-info-circle me-1"></i> This action permanently deletes the team and associated project tasks. All team members will be released to join or create other teams immediately.
        </div>
      </div>
      <div class="modal-footer border-0 pt-0">
        <button type="button" class="btn btn-light btn-sm rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-danger btn-sm rounded-pill px-3" id="btnConfirmDeleteTeam" data-teamid="<%= activeTeam._id %>">
          <i class="bi bi-trash3-fill me-1"></i> Yes, Delete Team
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Modal: Remove Teammate Confirmation -->
<div class="modal fade" id="deleteTeammateModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content card-custom">
      <div class="modal-header border-0 pb-0">
        <h5 class="modal-title fw-bold text-danger"><i class="bi bi-person-x-fill me-2"></i> Remove Teammate</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body py-3">
        <p class="mb-2 text-dark">Are you sure you want to remove <strong id="deleteTeammateName">this member</strong> from the team?</p>
        <div class="alert alert-info small mb-0">
          <i class="bi bi-info-circle me-1"></i> Any uncompleted tasks assigned to this teammate will be returned to the unassigned project pool.
        </div>
      </div>
      <div class="modal-footer border-0 pt-0">
        <button type="button" class="btn btn-light btn-sm rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-danger btn-sm rounded-pill px-3" id="btnConfirmDeleteTeammate">
          <i class="bi bi-person-x-fill me-1"></i> Yes, Remove Teammate
        </button>
      </div>
    </div>
  </div>
</div>
<% } %>

<%- include('../partials/footer') %>
