<%- include('../partials/header') %>

<div class="row g-4">
  <!-- Left Column: Student Profile & Guide -->
  <div class="col-lg-4">
    <!-- Profile Card -->
    <div class="card card-custom p-4 mb-4">
      <div class="d-flex align-items-center gap-3 mb-3">
        <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center" style="width: 55px; height: 55px;">
          <i class="bi bi-person-fill fs-2"></i>
        </div>
        <div>
          <h5 class="fw-bold mb-0 text-dark"><%= student.fullName %></h5>
          <span class="text-muted small">@<%= student.username %></span>
        </div>
      </div>

      <div class="border-top pt-3">
        <div class="d-flex justify-content-between align-items-center mb-2">
          <span class="text-muted small">Student Type:</span>
          <span class="badge <%= student.studentType === 'INTERNAL' ? 'badge-internal' : 'badge-external' %>">
            <%= student.studentType %>
          </span>
        </div>
        <% if (student.studentType === 'INTERNAL') { %>
          <div class="d-flex justify-content-between align-items-center mb-2">
            <span class="text-muted small">Register Number:</span>
            <code class="fw-bold text-primary"><%= student.registerNumber %></code>
          </div>
        <% } %>
        <div class="d-flex justify-content-between align-items-center mb-2">
          <span class="text-muted small">College Email:</span>
          <span class="small font-mono text-dark"><%= student.email %></span>
        </div>
        <div class="d-flex justify-content-between align-items-center">
          <span class="text-muted small">Assigned Guide:</span>
          <span class="small fw-semibold text-dark">
            <%= student.assignedFaculty ? student.assignedFaculty.fullName : 'None (Select Below)' %>
          </span>
        </div>
      </div>

      <% if (!student.assignedFaculty) { %>
        <div class="mt-3">
          <a href="/student/select-faculty" class="btn btn-outline-primary btn-sm w-100">
            <i class="bi bi-person-lines-fill me-1"></i> Choose Faculty Guide
          </a>
        </div>
      <% } %>
    </div>

    <!-- Quick Actions Card -->
    <div class="card card-custom p-4">
      <h6 class="fw-bold text-dark mb-3"><i class="bi bi-lightning-charge me-1 text-primary"></i> Quick Actions</h6>
      <div class="d-grid gap-2">
        <a href="/student/select-faculty" class="btn btn-light text-start btn-sm py-2">
          <i class="bi bi-search me-2 text-primary"></i> Browse Faculty Directory
        </a>
        <a href="/student/create-team" class="btn btn-light text-start btn-sm py-2">
          <i class="bi bi-people me-2 text-primary"></i> Create / Manage Team
        </a>
      </div>
    </div>
  </div>

  <!-- Right Column: Active Team & Project Workspace -->
  <div class="col-lg-8">
    <% if (activeTeam) { %>
      <!-- Active Team Card -->
      <div class="card card-custom p-4 mb-4">
        <div class="d-flex justify-content-between align-items-start mb-3">
          <div>
            <div class="d-flex align-items-center gap-2 mb-1">
              <h4 class="fw-bold text-dark mb-0"><%= activeTeam.name %></h4>
              <% if (activeTeam.isMixedTeam) { %>
                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle small">
                  <i class="bi bi-shuffle me-1"></i> Mixed Collaboration
                </span>
              <% } %>
            </div>
            <p class="text-muted small mb-0">
              Faculty Guide: <strong><%= activeTeam.faculty ? activeTeam.faculty.fullName : 'Unassigned' %></strong>
            </p>
          </div>
          <button class="btn btn-outline-danger btn-sm" id="btnLeaveTeam" data-teamid="<%= activeTeam._id %>">
            <i class="bi bi-box-arrow-left"></i> Leave Team
          </button>
        </div>

        <!-- Teammates -->
        <div class="bg-light p-3 rounded-3 mb-4">
          <h6 class="fw-semibold text-secondary small text-uppercase mb-2">Team Members (<%= activeTeam.members.filter(m => m.status === 'ACTIVE').length %>)</h6>
          <div class="row g-2">
            <% activeTeam.members.filter(m => m.status === 'ACTIVE').forEach(function(m) { %>
              <div class="col-md-6">
                <div class="bg-white p-2 rounded border d-flex justify-content-between align-items-center small">
                  <div>
                    <span class="fw-semibold text-dark"><%= m.student ? m.student.fullName : 'Member' %></span>
                    <span class="text-muted">(@<%= m.student ? m.student.username : '' %>)</span>
                  </div>
                  <span class="badge <%= m.studentType === 'INTERNAL' ? 'badge-internal' : 'badge-external' %>">
                    <%= m.studentType %>
                  </span>
                </div>
              </div>
            <% }); %>
          </div>
        </div>

        <!-- Current Project Status -->
        <div class="border-top pt-3">
          <% if (activeTeam.currentProject) { %>
            <div class="d-flex justify-content-between align-items-center">
              <div>
                <span class="text-muted small d-block">Current Project</span>
                <h5 class="fw-bold text-dark mb-1"><%= activeTeam.currentProject.title %></h5>
                <span class="status-badge status-<%= activeTeam.currentProject.status.toLowerCase().replace('_', '') %>">
                  <i class="bi bi-circle-fill" style="font-size: 0.5rem;"></i> Status: <%= activeTeam.currentProject.status %>
                </span>
              </div>
              <a href="/project/<%= activeTeam.currentProject._id %>/workspace" class="btn btn-primary-custom">
                <i class="bi bi-layout-text-window-reverse me-1"></i> Open Project Workspace
              </a>
            </div>
          <% } else { %>
            <div class="text-center py-4 bg-light rounded-3">
              <i class="bi bi-journal-plus text-primary fs-2 mb-2 d-block"></i>
              <h6 class="fw-bold text-dark mb-1">No Ongoing Project</h6>
              <p class="text-muted small mb-3">Your team does not have an active project yet. Propose your project topic now.</p>
              <button class="btn btn-primary-custom btn-sm" data-bs-toggle="modal" data-bs-target="#proposeProjectModal">
                <i class="bi bi-file-earmark-plus me-1"></i> Propose Project
              </button>
            </div>
          <% } %>
        </div>
      </div>
    <% } else { %>
      <!-- No Team Notice -->
      <div class="card card-custom p-5 text-center mb-4">
        <i class="bi bi-people-fill text-muted fs-1 mb-3"></i>
        <h4 class="fw-bold text-dark">You are not in an active team</h4>
        <p class="text-muted small mb-4">Select a faculty guide and create a team of 1 to 9 students to start your project.</p>
        <div>
          <a href="/student/create-team" class="btn btn-primary-custom px-4">
            <i class="bi bi-plus-circle me-1"></i> Create a Team Now
          </a>
        </div>
      </div>
    <% } %>

    <!-- Student Tasks Section -->
    <div class="card card-custom p-4">
      <h5 class="fw-bold text-dark mb-3"><i class="bi bi-check2-square text-primary me-2"></i> My Assigned Tasks</h5>
      <% if (tasks && tasks.length > 0) { %>
        <div class="list-group list-group-flush">
          <% tasks.forEach(function(task) { %>
            <div class="list-group-item px-0 py-3 d-flex justify-content-between align-items-center">
              <div>
                <h6 class="fw-bold mb-1 text-dark"><%= task.title %></h6>
                <p class="text-muted small mb-0"><%= task.description %></p>
              </div>
              <span class="status-badge status-<%= task.status.toLowerCase().replace('_', '') %>">
                <%= task.status %>
              </span>
            </div>
          <% }); %>
        </div>
      <% } else { %>
        <p class="text-muted small mb-0">No assigned tasks currently pending for your account.</p>
      <% } %>
    </div>
  </div>
</div>

<!-- Modal: Propose Project -->
<% if (activeTeam) { %>
<div class="modal fade" id="proposeProjectModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content card-custom">
      <div class="modal-header border-0 pb-0">
        <h5 class="modal-title fw-bold">Propose New Academic Project</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form id="proposeProjectForm">
        <div class="modal-body">
          <input type="hidden" name="teamId" value="<%= activeTeam._id %>">
          <div class="mb-3">
            <label class="form-label">Project Title <span class="text-danger">*</span></label>
            <input type="text" class="form-control" name="title" id="projTitle" required placeholder="e.g. Distributed Task Orchestrator">
          </div>
          <div class="mb-3">
            <label class="form-label">Project Description & Scope <span class="text-danger">*</span></label>
            <textarea class="form-control" name="description" id="projDesc" rows="4" required placeholder="Detail the objectives, tech stack, and deliverables..."></textarea>
          </div>
          <div id="proposalModalAlert" class="alert d-none small mb-0"></div>
        </div>
        <div class="modal-footer border-0 pt-0">
          <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary-custom">Submit Proposal</button>
        </div>
      </form>
    </div>
  </div>
</div>
<% } %>

<script>
$(document).ready(function() {
  // Propose project AJAX
  $('#proposeProjectForm').on('submit', function(e) {
    e.preventDefault();
    const alertBox = $('#proposalModalAlert');
    alertBox.addClass('d-none');

    const payload = {
      teamId: $('input[name="teamId"]').val(),
      title: $('#projTitle').val(),
      description: $('#projDesc').val()
    };

    $.ajax({
      url: '/project/propose',
      type: 'POST',
      contentType: 'application/json',
      data: JSON.stringify(payload),
      success: function(res) {
        alertBox.removeClass('alert-danger d-none').addClass('alert alert-success d-block').text(res.message);
        setTimeout(function() {
          window.location.reload();
        }, 1200);
      },
      error: function(xhr) {
        const msg = xhr.responseJSON && xhr.responseJSON.message ? xhr.responseJSON.message : 'Error submitting proposal.';
        alertBox.removeClass('alert-success d-none').addClass('alert alert-danger d-block').text(msg);
      }
    });
  });

  // Leave team AJAX
  $('#btnLeaveTeam').on('click', function() {
    if (!confirm('Are you sure you want to leave this team? Remember: institutional policy prevents leaving while an active project is ongoing.')) {
      return;
    }
    const teamId = $(this).data('teamid');

    $.ajax({
      url: '/student/leave-team',
      type: 'POST',
      contentType: 'application/json',
      data: JSON.stringify({ teamId }),
      success: function(res) {
        alert(res.message);
        window.location.reload();
      },
      error: function(xhr) {
        const msg = xhr.responseJSON && xhr.responseJSON.message ? xhr.responseJSON.message : 'Cannot leave team.';
        alert(msg);
      }
    });
  });
});
</script>

<%- include('../partials/footer') %>
