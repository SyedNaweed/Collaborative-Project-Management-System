<nav class="navbar navbar-expand-lg navbar-dark navbar-custom sticky-top">
  <div class="container">
    <a class="navbar-brand d-flex align-items-center gap-2" href="/">
      <i class="bi bi-kanban-fill fs-4 text-primary"></i>
      <span>CPMS</span>
    </a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navMenu">
      <ul class="navbar-nav me-auto mb-2 mb-lg-0">
        <% if (currentUser) { %>
          <% if (currentUser.role === 'STUDENT') { %>
            <li class="nav-item">
              <a class="nav-link" href="/student/dashboard"><i class="bi bi-speedometer2"></i> Dashboard</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/student/select-faculty"><i class="bi bi-person-lines-fill"></i> Faculty List</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/student/create-team"><i class="bi bi-people-fill"></i> Create Team</a>
            </li>
          <% } else if (currentUser.role === 'FACULTY') { %>
            <li class="nav-item">
              <a class="nav-link" href="/faculty/dashboard"><i class="bi bi-speedometer2"></i> Faculty Dashboard</a>
            </li>
          <% } %>
        <% } %>
      </ul>

      <div class="d-flex align-items-center gap-3">
        <% if (currentUser) { %>
          <div class="text-white-50 small d-none d-md-block text-end">
            <div class="text-white fw-semibold"><%= currentUser.fullName %></div>
            <% if (currentUser.role === 'STUDENT') { %>
              <span class="badge <%= currentUser.studentType === 'INTERNAL' ? 'badge-internal' : 'badge-external' %>">
                <%= currentUser.studentType %> STUDENT
              </span>
            <% } else { %>
              <span class="badge badge-faculty">FACULTY</span>
            <% } %>
          </div>
          <a href="/auth/logout" class="btn btn-outline-light btn-sm rounded-pill px-3">
            <i class="bi bi-box-arrow-right"></i> Logout
          </a>
        <% } else { %>
          <a href="/auth/login" class="btn btn-outline-light btn-sm rounded-pill px-3">
            <i class="bi bi-box-arrow-in-right"></i> Sign In
          </a>
          <div class="dropdown">
            <button class="btn btn-primary-custom btn-sm dropdown-toggle rounded-pill px-3" type="button" data-bs-toggle="dropdown">
              Register
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow">
              <li><a class="dropdown-item" href="/auth/student-register"><i class="bi bi-mortarboard me-2"></i> Student Registration</a></li>
              <li><a class="dropdown-item" href="/auth/faculty-register"><i class="bi bi-person-badge me-2"></i> Faculty Registration</a></li>
            </ul>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</nav>
