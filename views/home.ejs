<!-- 3. PROJECT LIFECYCLE (5 STAGES) -->
<section id="lifecycle" class="py-5" style="background-color: #f1f5f9;">
  <div class="container py-4">
    <div class="text-center mb-5">
      <span class="badge bg-indigo bg-opacity-10 text-primary px-3 py-2 rounded-pill fw-bold text-uppercase small mb-2">
        <i class="bi bi-diagram-3 me-1"></i> Standard Academic Pipeline
      </span>
      <h2 class="fw-bold text-dark mb-2">5-Stage Academic Project Lifecycle</h2>
      <p class="text-muted" style="max-width: 620px; margin: 0 auto;">
        From initial guide allocation to formal final evaluation, every phase is governed by strict system constraints and role-based actions.
      </p>
    </div>

    <div class="row g-4">
      <!-- Step 1 -->
      <div class="col-md-6 col-lg">
        <div class="timeline-step-card">
          <div class="timeline-number">01</div>
          <h6 class="fw-bold text-dark mb-2">Guide Allocation & Team Assembly</h6>
          <p class="text-muted small mb-0">
            Internal & External students select faculty within capacity limits and form squads (1–9 members) with mandatory mixed-cohort declarations.
          </p>
        </div>
      </div>

      <!-- Step 2 -->
      <div class="col-md-6 col-lg">
        <div class="timeline-step-card">
          <div class="timeline-number">02</div>
          <h6 class="fw-bold text-dark mb-2">Proposal & Revision Loop</h6>
          <p class="text-muted small mb-0">
            Teams submit formal proposals. Faculty reviews, approves, or marks <span class="badge bg-warning text-dark" style="font-size:0.65rem;">REVISION_REQUESTED</span> with structured edit cycles.
          </p>
        </div>
      </div>

      <!-- Step 3 -->
      <div class="col-md-6 col-lg">
        <div class="timeline-step-card">
          <div class="timeline-number">03</div>
          <h6 class="fw-bold text-dark mb-2">Kanban & Task Assignment</h6>
          <p class="text-muted small mb-0">
            Deconstruct milestones into granular tasks with assignees, strict deadlines, priority levels, and dependency chains.
          </p>
        </div>
      </div>

      <!-- Step 4 -->
      <div class="col-md-6 col-lg">
        <div class="timeline-step-card">
          <div class="timeline-number">04</div>
          <h6 class="fw-bold text-dark mb-2">AI Deliverable Analysis</h6>
          <p class="text-muted small mb-0">
            Upon submission, our AI engine computes scope alignment, inspects code similarity, and attaches an advisory quality report.
          </p>
        </div>
      </div>

      <!-- Step 5 -->
      <div class="col-md-6 col-lg">
        <div class="timeline-step-card">
          <div class="timeline-number">05</div>
          <h6 class="fw-bold text-dark mb-2">Faculty Verification & Rubrics</h6>
          <p class="text-muted small mb-0">
            Faculty inspects deliverable versions and AI reports, decides <span class="text-success fw-bold">Approve</span> or <span class="text-danger fw-bold">Request Rework</span>, and inputs final grades.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

