<%- include('../partials/header') %>

<div class="row justify-content-center">
  <div class="col-md-9 col-lg-7">
    <div class="card card-custom auth-card p-4 p-md-5">
      <div class="text-center mb-4">
        <div class="d-inline-flex align-items-center justify-content-center bg-purple bg-opacity-10 text-purple rounded-circle mb-3" style="width: 60px; height: 60px; background-color: #ede9fe; color: #6d28d9;">
          <i class="bi bi-person-badge-fill fs-3"></i>
        </div>
        <h3 class="fw-bold text-dark mb-1">Faculty Registration</h3>
        <p class="text-muted small">Register as a Faculty Project Guide</p>
      </div>

      <div id="formAlert" class="alert d-none mb-4" role="alert"></div>

      <form id="facultyRegisterForm" novalidate>
        <!-- Full Name -->
        <div class="mb-3">
          <label for="fullName" class="form-label">Faculty Full Name <span class="text-danger">*</span></label>
          <input type="text" class="form-control" id="fullName" name="fullName" placeholder="e.g. Dr. A. Sharma" required>
          <div class="invalid-feedback" id="fullNameError"></div>
        </div>

        <!-- Employee ID -->
        <div class="mb-3">
          <label for="employeeId" class="form-label">Employee ID <span class="text-danger">*</span></label>
          <div class="input-group">
            <span class="input-group-text bg-light text-muted"><i class="bi bi-id-card"></i></span>
            <input type="text" class="form-control text-uppercase" id="employeeId" name="employeeId" placeholder="e.g. EMP50123" required>
          </div>
          <div class="invalid-feedback" id="employeeIdError"></div>
        </div>

        <!-- VIT Faculty Email -->
        <div class="mb-3">
          <label for="email" class="form-label">VIT Faculty Email <span class="text-danger">*</span></label>
          <div class="input-group">
            <span class="input-group-text bg-light text-muted"><i class="bi bi-envelope"></i></span>
            <input type="email" class="form-control" id="email" name="email" placeholder="name@vit.ac.in" required>
          </div>
          <div class="form-text small text-muted">Must be an institutional email ending with <strong>@vit.ac.in</strong></div>
          <div class="invalid-feedback" id="emailError"></div>
        </div>

        <!-- Team Handling Capacity (2 - 7) -->
        <div class="mb-3">
          <label for="facultyCapacity" class="form-label">Team-Handling Capacity (2 to 7) <span class="text-danger">*</span></label>
          <div class="input-group">
            <span class="input-group-text bg-light text-muted"><i class="bi bi-people"></i></span>
            <input type="number" class="form-control" id="facultyCapacity" name="facultyCapacity" min="2" max="7" placeholder="Between 2 and 7" required>
          </div>
          <div class="form-text small text-muted">Permitted capacity for concurrent teams is strictly between 2 and 7.</div>
          <div class="invalid-feedback" id="facultyCapacityError"></div>
        </div>

        <!-- Username -->
        <div class="mb-3">
          <label for="username" class="form-label">Username <span class="text-danger">*</span></label>
          <div class="input-group">
            <span class="input-group-text bg-light text-muted">@</span>
            <input type="text" class="form-control" id="username" name="username" placeholder="Alphabetic only (e.g. suresh)" required>
          </div>
          <div class="form-text small text-muted">Must contain only alphabetic letters (no numbers or special characters).</div>
          <div class="invalid-feedback" id="usernameError"></div>
        </div>

        <!-- Passwords -->
        <div class="row g-2 mb-4">
          <div class="col-md-6">
            <label for="password" class="form-label">Password <span class="text-danger">*</span></label>
            <input type="password" class="form-control" id="password" name="password" placeholder="At least 6 characters" required>
            <div class="invalid-feedback" id="passwordError"></div>
          </div>
          <div class="col-md-6">
            <label for="confirmPassword" class="form-label">Confirm Password <span class="text-danger">*</span></label>
            <input type="password" class="form-control" id="confirmPassword" name="confirmPassword" placeholder="Re-enter password" required>
            <div class="invalid-feedback" id="confirmPasswordError"></div>
          </div>
        </div>

        <button type="submit" class="btn btn-primary-custom w-100 py-2 mb-3">
          <i class="bi bi-person-badge-fill"></i> Complete Faculty Registration
        </button>

        <div class="text-center">
          <span class="text-muted small">Already have an account?</span>
          <a href="/auth/login" class="text-decoration-none fw-semibold small ms-1">Sign In</a>
        </div>
      </form>
    </div>
  </div>
</div>

<script src="/js/authValidation.js"></script>
<%- include('../partials/footer') %>
