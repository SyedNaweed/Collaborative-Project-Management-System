<%- include('../partials/header') %>

<div class="row justify-content-center">
  <div class="col-md-7 col-lg-5">
    <div class="card card-custom auth-card p-4 p-md-5">
      <div class="text-center mb-4">
        <div class="d-inline-flex align-items-center justify-content-center bg-warning bg-opacity-10 text-warning rounded-circle mb-3" style="width: 60px; height: 60px;">
          <i class="bi bi-key-fill fs-3 text-warning-emphasis"></i>
        </div>
        <h3 class="fw-bold text-dark mb-1">Password Recovery</h3>
        <p class="text-muted small">Verify your registered college email via OTP to reset your password</p>
      </div>

      <div id="forgotAlert" class="alert d-none mb-4" role="alert"></div>

      <form id="forgotPasswordForm" novalidate>
        <!-- Step 1: Username & Identity Verification -->
        <div class="mb-3">
          <label for="recoveryUsername" class="form-label">Registered Username <span class="text-danger">*</span></label>
          <div class="input-group">
            <span class="input-group-text bg-light text-muted">@</span>
            <input type="text" class="form-control" id="recoveryUsername" name="username" placeholder="Enter your username" required>
            <button type="button" class="btn btn-outline-primary" id="btnSendRecoveryOtp">
              <i class="bi bi-send"></i> Send OTP
            </button>
          </div>
          <div class="form-text small text-muted" id="maskedEmailNotice"></div>
          <div class="invalid-feedback" id="recoveryUsernameError"></div>
        </div>

        <!-- Step 2: OTP Entry -->
        <div class="mb-3">
          <label for="recoveryOtp" class="form-label">Recovery OTP <span class="text-danger">*</span></label>
          <div class="input-group">
            <span class="input-group-text bg-light text-muted"><i class="bi bi-shield-check"></i></span>
            <input type="text" class="form-control font-mono" id="recoveryOtp" name="otp" placeholder="Enter 6-digit OTP" maxlength="6" required>
          </div>
          <div class="invalid-feedback" id="recoveryOtpError"></div>
        </div>

        <!-- Step 3: New Passwords -->
        <div class="mb-3">
          <label for="newPassword" class="form-label">New Password <span class="text-danger">*</span></label>
          <input type="password" class="form-control" id="newPassword" name="newPassword" placeholder="At least 6 characters" required>
          <div class="invalid-feedback" id="newPasswordError"></div>
        </div>

        <div class="mb-4">
          <label for="confirmNewPassword" class="form-label">Confirm New Password <span class="text-danger">*</span></label>
          <input type="password" class="form-control" id="confirmNewPassword" name="confirmNewPassword" placeholder="Re-enter new password" required>
          <div class="invalid-feedback" id="confirmNewPasswordError"></div>
        </div>

        <button type="submit" class="btn btn-primary-custom w-100 py-2 mb-3">
          <i class="bi bi-check2-circle"></i> Reset Password
        </button>

        <div class="text-center border-top pt-3">
          <a href="/auth/login" class="text-decoration-none small fw-semibold">
            <i class="bi bi-arrow-left"></i> Back to Sign In
          </a>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
$(document).ready(function() {
  let recoveryEmail = '';

  $('#btnSendRecoveryOtp').on('click', function() {
    const username = $('#recoveryUsername').val().trim();
    const alertBox = $('#forgotAlert');
    alertBox.addClass('d-none');
    $('#recoveryUsername').removeClass('is-invalid');

    if (!username) {
      $('#recoveryUsername').addClass('is-invalid');
      $('#recoveryUsernameError').text('Please enter your username first.');
      return;
    }

    const $btn = $(this);
    $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm"></span> Sending...');

    $.ajax({
      url: '/auth/forgot-password/send-otp',
      type: 'POST',
      contentType: 'application/json',
      data: JSON.stringify({ username }),
      success: function(res) {
        $btn.prop('disabled', false).html('<i class="bi bi-send"></i> Resend');
        recoveryEmail = res.email;
        $('#maskedEmailNotice').html(`<span class="text-success"><i class="bi bi-check-circle"></i> OTP sent to registered email: <strong>${res.maskedEmail}</strong></span>`);
        if (res.devOtp) {
          $('#recoveryOtp').val(res.devOtp);
        }
        alertBox.removeClass('alert-danger d-none').addClass('alert alert-success d-block').text(res.message);
      },
      error: function(xhr) {
        $btn.prop('disabled', false).html('<i class="bi bi-send"></i> Send OTP');
        const msg = xhr.responseJSON && xhr.responseJSON.message ? xhr.responseJSON.message : 'Invalid or incomplete recovery request.';
        alertBox.removeClass('alert-success d-none').addClass('alert alert-danger d-block').text(msg);
      }
    });
  });

  $('#forgotPasswordForm').on('submit', function(e) {
    e.preventDefault();
    const alertBox = $('#forgotAlert');
    alertBox.addClass('d-none');
    $('.is-invalid').removeClass('is-invalid');

    const username = $('#recoveryUsername').val().trim();
    const otp = $('#recoveryOtp').val().trim();
    const newPassword = $('#newPassword').val();
    const confirmNewPassword = $('#confirmNewPassword').val();

    if (newPassword !== confirmNewPassword) {
      $('#confirmNewPassword').addClass('is-invalid');
      $('#confirmNewPasswordError').text('Passwords do not match.');
      return;
    }

    $.ajax({
      url: '/auth/forgot-password/reset',
      type: 'POST',
      contentType: 'application/json',
      data: JSON.stringify({ username, otp, newPassword, confirmNewPassword }),
      success: function(res) {
        alertBox.removeClass('alert-danger d-none').addClass('alert alert-success d-block').text(res.message);
        setTimeout(function() {
          window.location.href = '/auth/login';
        }, 1500);
      },
      error: function(xhr) {
        const data = xhr.responseJSON;
        if (data && data.errors) {
          Object.keys(data.errors).forEach(function(field) {
            $(`#${field}`).addClass('is-invalid');
            $(`#${field}Error`).text(data.errors[field]);
          });
        } else {
          alertBox.removeClass('alert-success d-none').addClass('alert alert-danger d-block').text(data.message || 'Password reset failed.');
        }
      }
    });
  });
});
</script>

<%- include('../partials/footer') %>
