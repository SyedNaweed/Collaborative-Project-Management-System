<%- include('../partials/header') %>

<div class="row justify-content-center">
  <div class="col-md-9 col-lg-7">
    <div class="card card-custom auth-card p-4 p-md-5">
      <div class="text-center mb-4">
        <div class="d-inline-flex align-items-center justify-content-center bg-primary bg-opacity-10 text-primary rounded-circle mb-3" style="width: 60px; height: 60px;">
          <i class="bi bi-mortarboard-fill fs-3"></i>
        </div>
        <h3 class="fw-bold text-dark mb-1">Student Registration</h3>
        <p class="text-muted small">Register as an Internal VIT student or an External collaborative student</p>
      </div>

      <div id="formAlert" class="alert d-none mb-4" role="alert"></div>

      <form id="studentRegisterForm" novalidate>
        <!-- 1. Student Type Selector -->
        <div class="mb-4">
          <label class="form-label d-block text-dark fw-bold">Select Student Type <span class="text-danger">*</span></label>
          <div class="row g-2">
            <div class="col-6">
              <input type="radio" class="btn-check" name="studentType" id="typeInternal" value="INTERNAL" checked>
              <label class="btn btn-outline-primary w-100 py-2 d-flex flex-column align-items-center justify-content-center gap-1" for="typeInternal">
                <i class="bi bi-building"></i>
                <span class="fw-bold">Internal Student</span>
                <span class="small text-muted" style="font-size: 0.72rem;">VIT Campus enrolled</span>
              </label>
            </div>
            <div class="col-6">
              <input type="radio" class="btn-check" name="studentType" id="typeExternal" value="EXTERNAL">
              <label class="btn btn-outline-warning text-dark w-100 py-2 d-flex flex-column align-items-center justify-content-center gap-1" for="typeExternal">
                <i class="bi bi-globe2"></i>
                <span class="fw-bold">External Student</span>
                <span class="small text-muted" style="font-size: 0.72rem;">Collaborative partner</span>
              </label>
            </div>
          </div>
          <div class="invalid-feedback d-block" id="studentTypeError"></div>
        </div>

        <!-- Full Name -->
        <div class="mb-3">
          <label for="fullName" class="form-label">Full Name <span class="text-danger">*</span></label>
          <input type="text" class="form-control" id="fullName" name="fullName" placeholder="Enter student's full name" required>
          <div class="invalid-feedback" id="fullNameError"></div>
        </div>

        <!-- Register Number (CONDITIONAL) -->
        <div class="mb-3" id="registerNumberContainer">
          <label for="registerNumber" class="form-label">
            Register Number <span class="text-danger" id="regNumberRequiredMark">*</span>
          </label>
          <div class="input-group">
            <span class="input-group-text bg-light text-muted"><i class="bi bi-card-text"></i></span>
            <input type="text" class="form-control text-uppercase" id="registerNumber" name="registerNumber" placeholder="e.g. 22BIT0061">
          </div>
          <div class="form-text small text-muted">Format: 2 numbers, 3 alphabets, and 4 numbers (e.g. 22BIT0061).</div>
          <div class="invalid-feedback" id="registerNumberError"></div>
        </div>

        <!-- Email & Help Text -->
        <div class="mb-3">
          <label for="email" class="form-label">Email Address <span class="text-danger">*</span></label>
          <div class="input-group">
            <span class="input-group-text bg-light text-muted"><i class="bi bi-envelope"></i></span>
            <input type="email" class="form-control" id="email" name="email" placeholder="Enter valid email" required>
            <button type="button" class="btn btn-outline-secondary" id="btnSendOtp" data-purpose="REGISTRATION">
              <i class="bi bi-send"></i> Send OTP
            </button>
          </div>
          <div id="emailHelpText" class="form-text mt-1"></div>
          <div class="invalid-feedback" id="emailError"></div>
        </div>

        <!-- OTP Status Alert Box -->
        <div id="otpStatusAlert" class="alert d-none py-2 px-3 small my-2" role="alert"></div>

        <!-- OTP Verification Code Input -->
        <div class="mb-3">
          <label for="otp" class="form-label">Email Verification OTP <span class="text-danger">*</span></label>
          <div class="input-group">
            <span class="input-group-text bg-light text-muted"><i class="bi bi-key-fill"></i></span>
            <input type="text" class="form-control font-mono" id="otp" name="otp" placeholder="Enter 6-digit OTP" maxlength="6" required>
          </div>
          <div class="invalid-feedback" id="otpError"></div>
        </div>

        <!-- Username -->
        <div class="mb-3">
          <label for="username" class="form-label">Username <span class="text-danger">*</span></label>
          <div class="input-group">
            <span class="input-group-text bg-light text-muted">@</span>
            <input type="text" class="form-control" id="username" name="username" placeholder="Alphabetic only (e.g. naweed)" required>
          </div>
          <div class="form-text small text-muted">Must contain only alphabetic letters (no numbers or special characters).</div>
          <div class="invalid-feedback" id="usernameError"></div>
        </div>

        <!-- Passwords -->
        <div class="row g-2 mb-4">
          <div class="col-md-6">
            <label for="password" class="form-label">Password <span class="text-danger">*</span></label>
            <input type="password" class="form-control" id="password" name="password" placeholder="At least 6 characters" required>
            <div class="invalid-feedback" id="passwordError"></div>
          </div>
          <div class="col-md-6">
            <label for="confirmPassword" class="form-label">Confirm Password <span class="text-danger">*</span></label>
            <input type="password" class="form-control" id="confirmPassword" name="confirmPassword" placeholder="Re-enter password" required>
            <div class="invalid-feedback" id="confirmPasswordError"></div>
          </div>
        </div>

        <button type="submit" class="btn btn-primary-custom w-100 py-2 mb-3">
          <i class="bi bi-person-plus-fill"></i> Complete Registration
        </button>

        <div class="text-center">
          <span class="text-muted small">Already have an account?</span>
          <a href="/auth/login" class="text-decoration-none fw-semibold small ms-1">Sign In</a>
        </div>
      </form>
    </div>
  </div>
</div>

<script src="/js/authValidation.js"></script>
<%- include('../partials/footer') %>
